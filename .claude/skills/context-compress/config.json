{
  "name": "context-compress",
  "version": "1.1.0",
  "note": "context-check.py 当前仍以内置默认值为权威源；本文件用于文档化和未来统一读取。",
  "defaultContextLimit": 200000,
  "defaultWarnPercent": 75,
  "maxCodeLines": 30,
  "supportedExtensions": [
    ".md",
    ".txt",
    ".c",
    ".h",
    ".cpp",
    ".hpp",
    ".py",
    ".js",
    ".ts",
    ".json",
    ".yaml",
    ".yml",
    ".xml",
    ".toml",
    ".ini",
    ".cfg",
    ".s",
    ".S",
    ".rs",
    ".go",
    ".java",
    ".kt",
    ".swift"
  ],
  "skipDirectories": [
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    ".claude",
    ".obsidian",
    "target",
    ".idea",
    ".vscode",
    "out",
    "bin",
    "obj"
  ],
  "hook": {
    "type": "command",
    "command": "python .claude/skills/context-compress/scripts/context-check.py --scan-workspace --warn-at-percent 75 --exit-zero"
  }
}
